{
  "annotations": {
    "list": []
  },
  "description": "Correlates k6 results with Kubernetes, database, Redis, RabbitMQ, KEDA and alert signals during load tests.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Requires k6 Prometheus Remote Write output.",
      "fieldConfig": { "defaults": { "decimals": 1, "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "editorMode": "code", "expr": "sum(irate(k6_http_reqs_total{testid=~\"$testid\"}[$__rate_interval]))", "legendFormat": "RPS", "range": true, "refId": "A" }],
      "title": "k6 HTTP RPS",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Requires k6 Prometheus Remote Write output.",
      "fieldConfig": { "defaults": { "decimals": 2, "max": 100, "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 5, "x": 5, "y": 0 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "editorMode": "code", "expr": "100 * avg(k6_http_req_failed_rate{testid=~\"$testid\"})", "legendFormat": "Failed", "range": true, "refId": "A" }],
      "title": "k6 Error Rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Set K6_PROMETHEUS_RW_TREND_STATS=p(95),p(99),max when running k6.",
      "fieldConfig": { "defaults": { "decimals": 3, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 5, "x": 10, "y": 0 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "editorMode": "code", "expr": "max(k6_http_req_duration_p95{testid=~\"$testid\"})", "legendFormat": "p95", "range": true, "refId": "A" }],
      "title": "k6 HTTP p95",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Set K6_PROMETHEUS_RW_TREND_STATS=p(95),p(99),max when running k6.",
      "fieldConfig": { "defaults": { "decimals": 3, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 5, "x": 15, "y": 0 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "editorMode": "code", "expr": "max(k6_http_req_duration_p99{testid=~\"$testid\"})", "legendFormat": "p99", "range": true, "refId": "A" }],
      "title": "k6 HTTP p99",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Iterations that k6 could not start at the configured arrival rate.",
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 0 },
      "id": 18,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "editorMode": "code", "expr": "sum(increase(k6_dropped_iterations_total{testid=~\"$testid\"}[$__range])) or vector(0)", "legendFormat": "Dropped", "range": false, "refId": "A" }],
      "title": "k6 Dropped Iterations",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "max": 100, "min": 0, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 5,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "editorMode": "code", "expr": "100 * sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\",pod=~\"$pod\",container!=\"\",image!=\"\"}[$__rate_interval])) / clamp_min(sum by (pod) (kube_pod_container_resource_limits{namespace=\"$namespace\",pod=~\"$pod\",resource=\"cpu\"}), 0.001)", "legendFormat": "{{pod}}", "range": true, "refId": "A" }],
      "title": "Pod CPU / Limit",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "max": 100, "min": 0, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 6,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "editorMode": "code", "expr": "100 * sum by (pod) (container_memory_working_set_bytes{namespace=\"$namespace\",pod=~\"$pod\",container!=\"\",image!=\"\"}) / clamp_min(sum by (pod) (kube_pod_container_resource_limits{namespace=\"$namespace\",pod=~\"$pod\",resource=\"memory\"}), 1)", "legendFormat": "{{pod}}", "range": true, "refId": "A" }],
      "title": "Pod Memory / Limit",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 13 },
      "id": 7,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "kube_deployment_status_replicas_available{namespace=\"$namespace\",deployment=~\"$workload\"}", "legendFormat": "{{deployment}} available", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"$namespace\",horizontalpodautoscaler=~\"$workload.*\"}", "legendFormat": "{{horizontalpodautoscaler}} desired", "range": true, "refId": "B" }
      ],
      "title": "Workload & HPA Replicas",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 4, "x": 8, "y": 13 },
      "id": 8,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "editorMode": "code", "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\",pod=~\"$pod\"}[$__range])) or vector(0)", "legendFormat": "Restarts", "range": false, "refId": "A" }],
      "title": "Pod Restarts",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "max": 100, "min": 0, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 13 },
      "id": 9,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "editorMode": "code", "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])))", "legendFormat": "{{instance}}", "range": true, "refId": "A" }],
      "title": "Node CPU Usage",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "max": 100, "min": 0, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 13 },
      "id": 10,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "editorMode": "code", "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "legendFormat": "{{instance}}", "range": true, "refId": "A" }],
      "title": "Node Memory Usage",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 1, "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 20 },
      "id": 11,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "sum(rate(redis_commands_processed_total{job=\"redis\"}[$__rate_interval]))", "legendFormat": "Commands/s", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "sum(redis_connected_clients{job=\"redis\"})", "legendFormat": "Clients", "range": true, "refId": "B" }
      ],
      "title": "Redis Throughput & Clients",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 1, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 20 },
      "id": 12,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "sum(rabbitmq_queue_messages_ready{job=\"rabbitmq\"})", "legendFormat": "Ready", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "sum(rabbitmq_queue_messages_unacked{job=\"rabbitmq\"})", "legendFormat": "Unacked", "range": true, "refId": "B" }
      ],
      "title": "RabbitMQ Queue Depth",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 1, "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 20 },
      "id": 13,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "sum(rate(rabbitmq_global_messages_received_total{job=\"rabbitmq\"}[$__rate_interval]))", "legendFormat": "Published/s", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "sum(rate(rabbitmq_global_messages_delivered_ack_total{job=\"rabbitmq\"}[$__rate_interval]))", "legendFormat": "Delivered/s", "range": true, "refId": "B" }
      ],
      "title": "RabbitMQ Message Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Shows PostgreSQL and MySQL connections when their exporters expose the corresponding metrics.",
      "fieldConfig": { "defaults": { "decimals": 0, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 27 },
      "id": 14,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "sum(pg_stat_database_numbackends)", "legendFormat": "PostgreSQL", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "sum(mysql_global_status_threads_connected)", "legendFormat": "MySQL", "range": true, "refId": "B" }
      ],
      "title": "Database Connections",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 5, "x": 8, "y": 27 },
      "id": 15,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "editorMode": "code", "expr": "sum(kube_pod_status_phase{namespace=\"$namespace\",phase=\"Pending\"} == 1) or vector(0)", "legendFormat": "Pending", "range": false, "refId": "A" }],
      "title": "Pending Pods",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 5, "x": 13, "y": 27 },
      "id": 16,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "editorMode": "code", "expr": "sum((kube_pod_status_ready{namespace=\"$namespace\",condition=\"true\"} == 0) and on (namespace, pod) (kube_pod_status_phase{namespace=\"$namespace\",phase=~\"Pending|Running|Unknown\"} == 1)) or vector(0)", "legendFormat": "Not Ready", "range": false, "refId": "A" }],
      "title": "Not Ready Pods",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 27 },
      "id": 17,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "editorMode": "code", "expr": "sum(ALERTS{alertstate=\"firing\",alertname!=\"Watchdog\"}) or vector(0)", "legendFormat": "Firing", "range": false, "refId": "A" }],
      "title": "Firing Alerts",
      "type": "stat"
    }
  ],
